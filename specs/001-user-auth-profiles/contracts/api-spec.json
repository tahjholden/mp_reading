{
  "openapi": "3.0.3",
  "info": {
    "title": "Reading App - Authentication & Profile Management API",
    "version": "1.0.0",
    "description": "API for parent and child authentication, profile management, and parent invitation system"
  },
  "servers": [
    {
      "url": "/api",
      "description": "SvelteKit API routes"
    }
  ],
  "paths": {
    "/auth/parent/signup": {
      "post": {
        "summary": "Create parent account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parent account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Parent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or email already exists"
          }
        }
      }
    },
    "/auth/parent/login": {
      "post": {
        "summary": "Parent login",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "object"
                    },
                    "parent": {
                      "$ref": "#/components/schemas/Parent"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/child/login": {
      "post": {
        "summary": "Child login (username/password)",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "session": {
                      "type": "object"
                    },
                    "child": {
                      "$ref": "#/components/schemas/Child"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/parents/children": {
      "get": {
        "summary": "List parent's children",
        "tags": ["Children"],
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "List of children",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Child"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create child profile",
        "tags": ["Children"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "age", "grade_level", "username", "password"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "age": {
                    "type": "integer",
                    "minimum": 9,
                    "maximum": 12
                  },
                  "grade_level": {
                    "type": "integer",
                    "enum": [4, 5, 6]
                  },
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 20
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Child profile created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Child"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or username already exists"
          }
        }
      }
    },
    "/parents/children/{childId}": {
      "get": {
        "summary": "Get child profile",
        "tags": ["Children"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Child profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Child"
                }
              }
            }
          },
          "403": {
            "description": "Access denied"
          },
          "404": {
            "description": "Child not found"
          }
        }
      },
      "put": {
        "summary": "Update child profile (primary parent only)",
        "tags": ["Children"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "reading_preferences": {
                    "type": "object"
                  },
                  "avatar_data": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Child profile updated"
          },
          "403": {
            "description": "Only primary parent can update"
          }
        }
      },
      "delete": {
        "summary": "Delete child profile (primary parent only)",
        "tags": ["Children"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Child profile deleted"
          },
          "403": {
            "description": "Only primary parent can delete"
          }
        }
      }
    },
    "/parents/children/{childId}/password": {
      "put": {
        "summary": "Reset child password (primary parent only)",
        "tags": ["Children"],
        "security": [{"BearerAuth": []}],
        "parameters": [
          {
            "name": "childId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["new_password"],
                "properties": {
                  "new_password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successful"
          },
          "403": {
            "description": "Only primary parent can reset password"
          }
        }
      }
    },
    "/parents/invitations": {
      "post": {
        "summary": "Invite secondary parent",
        "tags": ["Invitations"],
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["child_id", "invited_email"],
                "properties": {
                  "child_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "invited_email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invitation"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Only primary parent can invite"
          }
        }
      }
    },
    "/parents/invitations/{token}/accept": {
      "post": {
        "summary": "Accept parent invitation",
        "tags": ["Invitations"],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation accepted"
          },
          "400": {
            "description": "Invalid token or expired"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Parent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "notification_preferences": {
            "type": "object"
          }
        }
      },
      "Child": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "primary_parent_id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer"
          },
          "grade_level": {
            "type": "integer"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "reading_preferences": {
            "type": "object"
          },
          "avatar_data": {
            "type": "object"
          },
          "onboarding_completed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "child_id": {
            "type": "string",
            "format": "uuid"
          },
          "invited_email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "accepted", "rejected", "expired"]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}

